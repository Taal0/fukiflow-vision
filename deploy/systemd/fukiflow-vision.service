[Unit]
Description=FukiFlow Vision (LIGHT — typeset + compose)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fukiflow/fukiflow-vision
Environment=VISION_LIGHT=1
Environment=DEVICE=cpu
ExecStart=/opt/fukiflow/fukiflow-vision/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
