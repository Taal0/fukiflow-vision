# Absolute path to models directory
MODELS_DIR=./models

# cpu | mps | cuda (empty = auto)
DEVICE=

# Bubble YOLO-seg (v1 kept for rollback)
# BUBBLE_WEIGHT=models/bubble/yolov8n-seg-bubble-v2.pt
# BUBBLE_CONF=0.65
# BUBBLE_CONF_SOFT_HI=0.80
# BUBBLE_IMGSZ=640

# Panel YOLO detect (panel_v3)
# PANEL_WEIGHT=models/panel/yolov8n-panel-v3.pt
# PANEL_CONF=0.40
# PANEL_IMGSZ=640
# PANEL_NMS_IOU=0.60

# Reading order (RSP)
# ORDER_TOL_FRAC=0.02
# ORDER_IOB_CONTAINED=0.70
# ORDER_IOB_PARTIAL=0.15
# ORDER_AMBIG_DELTA=0.05
# ORDER_CONF_MIN=0.50

# Detect-stage ink filter (structure: glyph/punctuation presence)
# INK_TOL=40
# INK_MIN_PX=50
# INK_MIN_CC_AREA=12


# Inset-fill clean (authoritative default 10; older notes saying 3 px are stale)
# CLEAN_INSET=10
# CLEAN_RING=6
# CLEAN_UNIFORM_TOL=18
# CLEAN_UNIFORM_FRAC=0.85
# CLEAN_MIN_RING_PX=30

# Typeset (layout JSON; page-height-relative font ladder)
# TYPESET_FONT=assets/fonts/NotoSans-Regular.ttf
# TYPESET_MARGIN_RATIO=0.008
# TYPESET_FONT_MIN_RATIO=0.008
# TYPESET_FONT_MAX_RATIO=0.042
# TYPESET_FONT_STEPS=16
# TYPESET_LEADING=1.15
# TYPESET_WIDTH_SAFETY=0.98
# TYPESET_HYPHENATE=1
# TYPESET_HYPHEN_LANG=tr_TR
# TYPESET_HYPHEN_DIC=assets/hyphen/hyph_tr_TR.dic

# Page DPI for layout font_pt / leading_pt (PSD/IDML export)
# PAGE_DPI=350

# VERBOSE=0

# Skip YOLO bubble/panel load (typeset + compose only; cheap CPU demos)
# VISION_LIGHT=0
